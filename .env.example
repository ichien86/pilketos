# Salin file ini menjadi .env.local (development) atau .env (production) dan isi nilai asli.
# JANGAN commit file .env.local / .env ke git.

# MongoDB -- WAJIB replica set (bukan standalone), karena aplikasi memakai
# multi-document transaction (klaim bilik & submit vote). Lihat PRASYARAT_PENGEMBANGAN.md.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DB_PROD=pilketos_prod
MONGODB_DB_SIMULASI=pilketos_simulasi

# Secret untuk sesi login (JWT httpOnly cookie) -- pemilih/admin/panitia/kandidat.
# Generate dengan: openssl rand -base64 48
AUTH_JWT_SECRET=ganti_dengan_secret_acak_minimal_32_karakter

# Secret KHUSUS untuk barcode identitas check-in (Bagian 2 dok. teknis v6).
# WAJIB berbeda dari AUTH_JWT_SECRET supaya kebocoran satu secret tidak
# otomatis membongkar yang lain.
SECRET_CHECKIN=ganti_dengan_secret_acak_lain_minimal_32_karakter

# Password default akun pemilih saat aktivasi pertama kali (US-02).
DEFAULT_PASSWORD=MAN3Byl

# Lokasi penyimpanan file upload video kampanye (disk lokal, lihat PRASYARAT_PENGEMBANGAN.md).
UPLOAD_DIR=./public/uploads

# Interval cron sweep TTL bilik/sesi, dalam detik (Bagian 4.4 & 5 dok. teknis).
CRON_SWEEP_INTERVAL_SECONDS=30
